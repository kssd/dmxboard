{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PlatformIO: Build Uno",
      "type": "shell",
      "command": "platformio",
      "args": ["run", "-e", "uno"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Test DMXDriver (host)",
      "type": "shell",
      "command": "c++ -std=c++11 -Itest/host/include -Ilib/DMXDriver/src test/host/test_dmx_driver.cpp lib/DMXDriver/src/DMXDriver.cpp -o .vscode/dmx-driver-tests && .vscode/dmx-driver-tests",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
